# Required: Loxo API key (Bearer token)
LOXO_API_KEY=

# Required: your Loxo agency slug, as in https://app.loxo.co/api/<slug>/...
LOXO_AGENCY_SLUG=

# Optional: Loxo host (default app.loxo.co)
LOXO_DOMAIN=app.loxo.co

# Required: one Zapier Catch Hook per routed stage (see src/constants.ts)
# Stage 17003 - AI Sourcing Enabled
ZAP_URL_AI_SOURCING=
# Stage 16749 - Applied
ZAP_URL_APPLIED=
# Stage 17529 - Ready to Submit
ZAP_URL_READY_TO_SUBMIT=

# Optional: if set, Loxo must call /webhooks/loxo?token=<this value>
WEBHOOK_SECRET=

# Optional locally; Cloud Run sets this itself
PORT=8080
